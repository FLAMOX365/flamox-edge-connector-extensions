{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["fileName", "content"],
  "properties": {
    "fileName": {
      "type": "string",
      "pattern": "^[^/\\\\]+\\.(?:csv|xml)$",
      "maxLength": 240
    },
    "content": { "type": "string", "minLength": 1, "maxLength": 524288 }
  }
}
