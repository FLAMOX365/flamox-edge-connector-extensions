{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CSV/XML Hotfolder configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseUrl"],
  "properties": {
    "baseUrl": {
      "type": "string",
      "title": "WebDAV base URL",
      "pattern": "^https?://[^\\s]+$",
      "maxLength": 500
    },
    "inboxPath": {
      "type": "string",
      "title": "Inbox path",
      "minLength": 1,
      "maxLength": 240,
      "default": "inbox"
    },
    "outboxPath": {
      "type": "string",
      "title": "Outbox path",
      "minLength": 1,
      "maxLength": 240,
      "default": "outbox"
    },
    "archivePath": {
      "type": "string",
      "title": "Archive path",
      "minLength": 1,
      "maxLength": 240,
      "default": "archive"
    },
    "requestTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60,
      "default": 20
    }
  }
}
