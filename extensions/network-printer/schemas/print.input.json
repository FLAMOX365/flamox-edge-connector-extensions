{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["jobName", "documentFormat", "documentBase64"],
  "properties": {
    "jobName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "documentFormat": {
      "type": "string",
      "enum": ["application/pdf", "image/jpeg", "image/png", "text/plain"]
    },
    "documentBase64": { "type": "string", "minLength": 1, "maxLength": 720000 }
  }
}
