{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Display configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["displayUrl"],
  "properties": {
    "displayUrl": {
      "type": "string",
      "title": "Display receiver URL",
      "pattern": "^https?://[^\\s]+$",
      "maxLength": 500
    },
    "requestTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30,
      "default": 10
    }
  }
}
