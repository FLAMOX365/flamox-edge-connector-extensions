{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["presentationId", "headline", "lines"],
  "properties": {
    "presentationId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "headline": { "type": "string", "minLength": 1, "maxLength": 160 },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "footer": { "type": "string", "minLength": 1, "maxLength": 240 },
    "qrCodeUrl": { "type": "string", "format": "uri", "maxLength": 500 },
    "expiresAt": { "type": "string", "format": "date-time" }
  }
}
