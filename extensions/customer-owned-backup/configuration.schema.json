{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer-owned Backup configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseUrl", "backupPath"],
  "properties": {
    "baseUrl": {
      "type": "string",
      "title": "WebDAV base URL",
      "pattern": "^https?://[^\\s]+$",
      "maxLength": 500
    },
    "backupPath": {
      "type": "string",
      "title": "Backup path",
      "minLength": 1,
      "maxLength": 240,
      "default": "backups"
    },
    "filePrefix": {
      "type": "string",
      "title": "File prefix",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "maxLength": 80,
      "default": "edge-backup"
    },
    "retentionCount": {
      "type": "integer",
      "title": "Snapshots to retain",
      "minimum": 1,
      "maximum": 365,
      "default": 30
    },
    "requestTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90,
      "default": 45
    }
  }
}
